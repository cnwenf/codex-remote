{
  "name": "codex-remote",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gateway": "tsx src/gateway/index.ts",
    "start": "pnpm build && tsx src/gateway/index.ts",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "e2e": "playwright test",
    "check": "tsc --noEmit && vitest run",
    "test:stack": "pnpm build && tsx scripts/start-test-stack.ts",
    "smoke:app-server": "node scripts/smoke-app-server.mjs",
    "build:mac": "scripts/build-macos-app.sh",
    "package:dmg": "scripts/package-macos-dmg.sh",
    "mobile:sync": "pnpm build && cap sync",
    "build:android": "pnpm mobile:sync && cd android && ./gradlew assembleRelease",
    "build:ios:sim": "pnpm mobile:sync && scripts/build-ios-simulator.sh",
    "build:ios:device": "pnpm mobile:sync && scripts/build-ios-unsigned.sh"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.2",
    "esbuild": "0.28.1",
    "jsdom": "26.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.5",
    "vitest": "3.2.6"
  }
}
