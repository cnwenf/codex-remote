# Generate a fresh value locally. Never commit a real token.
CODEX_WEB_TOKEN=replace-with-a-random-token
BIND_HOST=127.0.0.1
PORT=4310
# Required for VPN access, for example: http://10.0.0.8:4310
ALLOWED_ORIGINS=http://127.0.0.1:4310
# Set both only after Desktop was launched with the loopback bridge.
# CODEX_DESKTOP_CDP_ENDPOINT=http://127.0.0.1:9229
# CODEX_DESKTOP_APP_SERVER_VERSION=0.148.0-alpha.15
